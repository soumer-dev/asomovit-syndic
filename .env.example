# ─────────────────────────────────────────────────────────────────────────────
# Resend  (required — form submissions are delivered by email)
# Get your API key from: https://resend.com/api-keys
# The sender domain must be verified in your Resend account.
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here
# Comma-separated list of recipient email addresses
RECIPIENT_EMAIL=admin@syndic.asomovit.com

# ─────────────────────────────────────────────────────────────────────────────
# Application URL  (optional — used to derive the email sender domain)
# ─────────────────────────────────────────────────────────────────────────────
APP_URL=https://syndic.asomovit.com

# ─────────────────────────────────────────────────────────────────────────────
# Google Tag Manager  (optional — analytics)
# Format must be GTM-XXXXXXX  (replace with your real container ID)
# Get it from: https://tagmanager.google.com
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ─────────────────────────────────────────────────────────────────────────────
# Google reCAPTCHA v3  (optional — bot protection on the contact form)
# Get keys from: https://www.google.com/recaptcha/admin
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
